#!/usr/bin/env bash
set -euf -o pipefail

case "${DYD_LOG_LEVEL:-info}" in
  debug|trace) set -x ;;
  *) ;;
esac

src_package=$DYD_STEM
src_assets=$src_package/dyd/assets
src_dependencies=$src_package/dyd/dependencies
dest_package=$DYD_BUILD
dest_assets=$dest_package/dyd/assets
dest_traits=$dest_package/dyd/traits
work_dir=$dest_package/render-work
fixture=$(cat "$src_package/dyd/traits/fixture")
target=$(cat "$src_package/dyd/traits/target")

mkdir -p "$dest_assets" "$dest_traits" "$work_dir"
cp -r "$src_assets/." "$work_dir/"
chmod -R +w "$work_dir"
ln -s "$src_dependencies/dhall-codegen/dyd/assets" "$work_dir/dhall-codegen"

if [ "$fixture" = core ]; then
  cat > "$work_dir/render.dhall" <<'EOF'
let Grammar = ./dhall-codegen/grammar.dhall
let Document = Grammar.Document
let s = Grammar.Schema
let codec = ./dhall-codegen/codec-python-json/package.dhall
let Foo = s.root.from (s.text.from s.text.props::{=} s.text.meta::{=}) s.root.meta::{ name = "Foo" }
let Bar = s.root.from (s.number.from s.number.props::{ variant = s.number.variants.natural } s.number.meta::{=}) s.root.meta::{ name = "Bar" }
let document = Document::{ headers = [] : List Text, schemas = [ Foo, Bar ] # ./schemas-boolean.dhall # ./schemas-number.dhall # ./schemas-text.dhall # ./schemas-optional.dhall # ./schemas-list.dhall # ./schemas-tuple.dhall # ./schemas-set.dhall # ./schemas-map.dhall # ./schemas-record.dhall # ./schemas-time.dhall # ./schemas-any.dhall # ./schemas-reference.dhall # ./schemas-oneOf.dhall }
in codec.render document
EOF
else
  cat > "$work_dir/render.dhall" <<'EOF'
let codec = ./dhall-codegen/codec-python-json/package.dhall
in codec.render ./document.dhall
EOF
fi

dhall text --file "$work_dir/render.dhall" --output "$dest_assets/out.py"
rm -rf "$work_dir"
printf '%s' dhall-codegen-test-fixtures > "$dest_traits/name"
printf '%s' "$fixture" > "$dest_traits/fixture"
printf '%s' "$target" > "$dest_traits/target"
