{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://example.com/schemas/your-file.json",
	"$ref": "#/definitions/Person",
	"definitions": {
		"Person":
			{
				"type" : "object",
				"properties" : {
					"appointment_time" :
						{
							"type" : "string",
							"description" : "ISO 8601 local time",
							"pattern" : "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:[.][0-9]+)?(?![\\s\\S])"
						},
					"binary_data" :
						{
							"type": "string",
							"description" : "RFC 4648 Base64",
							"contentEncoding": "base64",
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}(?:==)?|[A-Za-z0-9+/]{3}=?)?$"
						},
					"birth_date" :
						{
							"type": "string",
							"description" : "ISO 8601 calendar date",
							"format": "date"
						},
					"created_at" :
						{
							"type": "string",
							"description" : "RFC 3339 date-time",
							"format": "date-time"
						},
					"date_of_birth" :
						{
							"type" : "string",
							"description" : "date of birth",
							"format" : "date"
						},
					"destination_ip" :
						{
							"type": "string",
							"description" : "IPv6 address",
							"format": "ipv6"
						},
					"friends" :
						{
							"type" : "array",
							"items" :
								{
									"$ref": "#/definitions/Person"
								},
							"description" : "friends"
						},
					"id" :
						{
							"type": "string",
							"description" : "RFC 4122 UUID",
							"format": "uuid"
						},
					"name" :
						{
							"type": "string",
							"description" : "full name"
						},
					"phone_number" :
						{
							"type": "string",
							"description" : "E.164 telephone number",
							"pattern": "^[+][1-9][0-9]{0,14}$"
						},
					"retention_period" :
						{
							"type" : "string",
							"description" : "ISO 8601 duration",
							"format" : "duration"
						},
					"source_ip" :
						{
							"type": "string",
							"description" : "IPv4 address",
							"format": "ipv4"
						},
					"token" :
						{
							"type": "string",
							"description" : "RFC 4648 Base64url",
							"contentEncoding": "base64url",
							"pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}(?:==)?|[A-Za-z0-9_-]{3}=?)?$"
						},
					"contact_email" :
						{
							"type": "string",
							"description" : "contact email (we might not have this)",
							"format": "email"
						}
				},
				"required" : [
					"appointment_time",
					"binary_data",
					"birth_date",
					"created_at",
					"date_of_birth",
					"destination_ip",
					"friends",
					"id",
					"name",
					"phone_number",
					"retention_period",
					"source_ip",
					"token"
				],
				"additionalProperties" : false
			}
	}
}