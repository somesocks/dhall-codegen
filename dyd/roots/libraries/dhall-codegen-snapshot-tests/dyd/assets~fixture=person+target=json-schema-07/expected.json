{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://example.com/schemas/your-file.json",
	"$ref": "#/definitions/Person",
	"definitions": {
		"Person":
			{
				"type" : "object",
				"properties" : {
					"birth_date" :
						{
							"type": "string",
							"description" : "ISO 8601 calendar date",
							"format": "date"
						},
					"created_at" :
						{
							"type": "string",
							"description" : "RFC 3339 date-time",
							"format": "date-time"
						},
					"date_of_birth" :
						{
							"type" : "string",
							"description" : "date of birth",
							"format" : "date-time"
						},
					"friends" :
						{
							"type" : "array",
							"items" :
								{
									"$ref": "#/definitions/Person"
								},
							"description" : "friends"
						},
					"name" :
						{
							"type": "string",
							"description" : "full name"
						},
					"contact_email" :
						{
							"type": "string",
							"description" : "contact email (we might not have this)",
							"format": "email"
						}
				},
				"required" : [
					"birth_date",
					"created_at",
					"date_of_birth",
					"friends",
					"name"
				],
				"additionalProperties" : false
			}
	}
}